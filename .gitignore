# ==========================================
# GITIGNORE CHO DỰ ÁN TƯƠNG TÁC DỮ LIỆU
# ==========================================

# 1. Bỏ qua các file dữ liệu nặng (Đặc biệt tránh lỗi GitHub 100MB limit)
data/raw/*.csv
data/processed/*.csv
!data/processed/.gitkeep
!data/processed/tracks_ml_data.csv
!data/sample/*.csv
!**/.gitkeep

# DVC / Large data archives
*.zip
*.tar.gz
*.7z

# 2. Python & Virtual Environment
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/

# 3. Jupyter Notebook Checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
notebooks/*.html

# 4. Model checkpoints & Large artifact files
models/*.pkl
models/*.joblib
models/*.h5
!models/.gitkeep

# 5. OS & IDE configurations
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# 6. Streamlit & Log files
.streamlit/secrets.toml
*.log

# 7. R Temporary Files
.RDataTmp
.Rhistory

